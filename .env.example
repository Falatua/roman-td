# Roman TD — environment variables template
#
# Copy this file to `.env.local` (for local dev) or set these in your
# CI / GitHub Actions secrets (for production builds). Both vars MUST
# start with VITE_ to make it into the client bundle. Without them
# the leaderboard silently falls back to localStorage — the game stays
# fully playable, just without cross-player scoring.
#
# See `LEADERBOARD_SETUP.md` for the full Supabase setup walkthrough.

# Your Supabase project URL — looks like https://abcdefg.supabase.co
VITE_SUPABASE_URL=

# Your Supabase project ANON key — long JWT-shaped string from
# Project Settings → API → Project API keys → `anon` `public`.
# This is the PUBLIC anon key — safe to ship in the client. Row-level
# security policies (see `supabase/schema.sql`) prevent abuse.
VITE_SUPABASE_ANON_KEY=

# OPTIONAL — Cloudflare Worker proxy URL for the leaderboard.
# When set, the bundle routes all Supabase REST requests through
# this Worker domain (e.g. https://roman-td-lb.yourname.workers.dev)
# instead of *.supabase.co directly. Used to bypass player-network
# mishandling of supabase.co URLs that return synthetic PGRST125
# 404s. Setup walkthrough in `cloudflare-worker/README.md`.
# When unset, the bundle hits Supabase directly (default).
VITE_LEADERBOARD_PROXY_URL=
